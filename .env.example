# Copy this file to .env or .env.local and fill in your API keys
# Never commit the actual .env file with real API keys

# Google Gemini API key for cartoon generation. Read by the server only
# (api/_shared/gemini.js via the Vercel function and dev-server.js); it is
# never shipped to the browser. Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: server-side Gemini model overrides. Single ID or comma-separated
# priority list. Built-in defaults are kept as fallbacks for when Google
# retires a model.
# GEMINI_TEXT_MODELS=gemini-3.1-pro-preview,gemini-3.8-flash
# GEMINI_IMAGE_MODELS=gemini-3-pro-image,gemini-3.1-flash-image

# Optional: Set environment (development/production)
VITE_ENV=development

# Optional: Backend API URL (defaults to localhost:3000 in dev)
# VITE_API_BASE_URL=http://localhost:3000

# Optional: OpenRouter API key if using alternative AI models
# Get yours at: https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Supabase configuration (required for the gallery feature). Read by the
# server only (api/_shared/gallery.js via the Vercel function and
# dev-server.js); nothing Supabase-related is shipped to the browser.
# Get these from your Supabase project settings > API. The service role key
# lets the server upload/insert regardless of RLS; an anon key also works if
# your storage and table policies allow anonymous inserts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override the storage bucket / table (both default to "cartoons")
# SUPABASE_GALLERY_BUCKET=cartoons
# SUPABASE_GALLERY_TABLE=cartoons
